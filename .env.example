# ════════════════════════════════════════════════════════
#  YamoBot — пример конфигурации
#  Скопируй этот файл в `.env` и заполни значения.
#  Без BOT_TOKEN бот НЕ запустится!
# ════════════════════════════════════════════════════════

# Обязательно: токен основного (главного) бота от @BotFather.
# Пример: 123456789:AAH5...XYZ
BOT_TOKEN=

# Твой Telegram ID — супер-админ платформы (принимает жалобы и т.п.).
# Необязательно для базовой работы, но полезно. Числом.
ADMIN=

# Алиас для совместимости (используется, если не задан ADMIN).
OWNER_ID=